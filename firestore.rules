rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore(mode) {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mode == mode
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= (mode == 'classic' ? 250 : 100)
        && request.resource.data.createdAt == request.time;
    }
    match /scores_classic/{scoreId} { allow read: if true; allow create: if validScore('classic'); allow update, delete: if false; }
    match /scores_triple/{scoreId} { allow read: if true; allow create: if validScore('triple'); allow update, delete: if false; }
  }
}
